Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Color: 160; 160; 164
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.8
    - Class: rviz_default_plugins/Path
      Name: PlannedPath
      Enabled: true
      Topic:
        Value: /planned_path
      Color: 0; 255; 255
      Line Width: 0.03
    - Class: rviz_default_plugins/Pose
      Name: EKFPose
      Enabled: true
      Topic:
        Value: /ekf_pose
      Color: 255; 25; 0
      Shape: Arrow
      Shaft Length: 0.3
      Shaft Radius: 0.04
      Head Length: 0.12
      Head Radius: 0.08
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /crazyflie/scan
      Size (m): 0.05
      Color: 255; 255; 255
      Style: Spheres
    - Class: rviz_default_plugins/MarkerArray
      Name: LinesRaw
      Enabled: true
      Topic:
        Value: /ekf_slam/debug/lines
    - Class: rviz_default_plugins/MarkerArray
      Name: CornersRaw
      Enabled: true
      Topic:
        Value: /ekf_slam/debug/corners
    - Class: rviz_default_plugins/MarkerArray
      Name: LandmarkLines
      Enabled: true
      Topic:
        Value: /ekf_slam/debug/landmark_lines
    - Class: rviz_default_plugins/MarkerArray
      Name: LandmarkCorners
      Enabled: true
      Topic:
        Value: /ekf_slam/debug/landmark_corners
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8.0
      Pitch: 1.5
      Yaw: 0.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: map
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Hide Left Dock: false
